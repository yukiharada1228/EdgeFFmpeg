{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "types": []
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "packages/runtime-node/**"
  ]
}
