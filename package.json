{
  "name": "edge-ffmpeg",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.workers.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run tests/unit",
    "check": "npm run typecheck && npm run types:declarations && npm run lint && npm run boundaries && npm test",
    "reference:build": "node tools/upstream-build/build.mjs",
    "reference:build:linux": "node tools/upstream-build/linux.mjs",
    "reference:probe:linux": "node tools/upstream-build/probe-linux-inverse.mjs",
    "reference:probe:linux-time": "node tools/upstream-build/probe-linux-inverse-time.mjs",
    "reference:extract": "node tools/extract-capabilities/index.mjs",
    "test:differential": "vitest run tests/differential --maxWorkers=1 --testTimeout=30000",
    "fate:inventory": "node tools/fate-adapter/index.mjs",
    "test:workers": "vitest run tests/workers --maxWorkers=1",
    "workers:types": "wrangler types tests/workers/env.d.ts --include-runtime false --include-main-module false",
    "workers:bundle": "wrangler deploy --dry-run --outdir .build/worker",
    "lint": "eslint packages tests",
    "boundaries": "node tools/package-boundaries/check.mjs",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "ffmpeg": "node tools/cli/run.mjs",
    "compat:report": "node tools/compatibility-report/run.mjs",
    "validate:fast": "node tools/ci/validate-fast.mjs",
    "fate:run": "node tools/fate-adapter/run.mjs",
    "fate:audit": "node tools/fate-adapter/audit.mjs",
    "reference:filter-syntax": "node tools/differential-runner/filter-syntax/generate.mjs",
    "reference:transpose-linux": "node tools/differential-runner/video-transpose/linux.mjs",
    "reference:transpose-workers": "node tools/differential-runner/video-transpose/generate-worker.mjs",
    "reference:filter-topology": "node tools/differential-runner/filter-graph/generate.mjs",
    "reference:complex-workers": "node tools/differential-runner/filter-graph/generate-worker.mjs",
    "reference:stack-workers": "node tools/differential-runner/video-stack/generate-worker.mjs",
    "reference:stream-workers": "node tools/differential-runner/video-stream/generate-worker.mjs",
    "reference:multi-cli-workers": "node tools/differential-runner/video-multi-cli/generate-worker.mjs",
    "reference:output-workers": "node tools/differential-runner/video-output/generate-worker.mjs",
    "reference:fpsmax-workers": "node tools/differential-runner/video-output/generate-video-fpsmax.mjs",
    "reference:clock-suffix-workers": "node tools/differential-runner/build-oracle.mjs encoder-ratio && node tools/differential-runner/video-output/generate-video-clock-suffix.mjs",
    "reference:clock-power-workers": "node tools/differential-runner/build-oracle.mjs encoder-ratio && node tools/differential-runner/video-output/generate-video-clock-power.mjs",
    "reference:expression-linux": "node tools/differential-runner/expression/generate-linux.mjs",
    "reference:timed-frame-sync-host": "node tools/differential-runner/timed-frame-sync/generate-host.mjs",
    "types:declarations": "tsc --declaration --emitDeclarationOnly --noEmit false --rootDir packages --outDir .build/types",
    "codec:h264:build": "node tools/codecs/openh264/build.mjs",
    "codec:flac:build": "python3 tools/codecs/flac/build.py",
    "reference:flac-characterization": "node tools/differential-runner/flac-characterization/generate.mjs",
    "bootstrap": "node tools/bootstrap/bootstrap.mjs",
    "bootstrap:check": "node tools/bootstrap/bootstrap.mjs --check",
    "linux:test": "node tools/linux/container-run.mjs test",
    "linux:corpora": "node tools/linux/container-run.mjs corpora"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "miniflare": "^5.20261118.0-beta",
    "typescript": "latest",
    "typescript-eslint": "^8.73.0",
    "vitest": "latest",
    "wrangler": "^4.165.0"
  }
}
