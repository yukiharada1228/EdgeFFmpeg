{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edge-ffmpeg-checkpoint-collect-local",
  "main": "media-checkpoint-collect-fixture.ts",
  "compatibility_date": "2026-11-18",
  "upload_source_maps": true,
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "edge-ffmpeg-checkpoint-collect-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHECKPOINTS",
        "class_name": "MediaCheckpointCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MediaCheckpointCoordinator"
      ]
    }
  ]
}
